# Database Configuration (PostgreSQL)
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
JDBC_URL=jdbc:postgresql://your-db-host/your-db-name?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key

# Redis Configuration
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent

# Uploadcare Configuration
UPLOAD_CARE_PUBLIC_KEY=your-public-key
UPLOAD_CARE_SECRET_KEY=your-secret-key

# Kafka Configuration (Aiven SCRAM / SASL_SSL)
KAFKA_BOOTSTRAP_SERVERS=your-aiven-kafka-uri:25186
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS_CONFIG="org.apache.kafka.common.security.scram.ScramLoginModule required username=\"avnadmin\" password=\"your-password\";"
KAFKA_SSL_TRUSTSTORE_CERTIFICATES="-----BEGIN CERTIFICATE-----\nYOUR_CA_CERTIFICATE_CONTENT\n-----END CERTIFICATE-----"

